# Copy to .env and change the two secrets. Nothing here is a real credential.
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
TZ=UTC

# Providers. The defaults need no API keys.
NCI_ASR_PROVIDER=fixture          # fixture | faster_whisper (uv sync --extra asr)
NCI_WHISPER_MODEL=small
NCI_LLM_PROVIDER=fake             # fake | anthropic | openai | ollama | gateway
NCI_LLM_MODEL=
NCI_LLM_API_KEY=
NCI_LLM_BASE_URL=                 # openai/ollama/gateway; gateway must expose an OpenAI-compatible API
NCI_LLM_PRICE_IN_PER_M=0          # USD per million input tokens, for the cost metric
NCI_LLM_PRICE_OUT_PER_M=0
NCI_RETENTION_DAYS=30
